# Discord Bot Token (https://discord.com/developers/applications)
TOKEN=your_discord_bot_token_here

# Müzik Komutlarının İzin Verildiği Metin Kanalı ID'si (Boş bırakılırsa tüm kanallarda çalışır)
TEXT_CHANNEL_ID=your_text_channel_id_here

# Spotify API Kimlik Bilgileri (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Uzak Sunucu SSH Deploy & Log İzleme Parametreleri
SSH_HOST=89.47.113.220
SSH_PORT=22
SSH_USER=Administrator
SSH_PASSWORD=your_remote_server_password_here

# ============================================================
# KULLANICI TAKİP & TELEFON ARAMA (CallMeBot / Telegram / WhatsApp)
# ============================================================
# Takip edilecek kullanıcının Discord kullanıcı adı (varsayılan: f6hako)
TRACK_USERNAME=f6hako
# VEYA kullanıcının kesin Discord ID'si (boş bırakılırsa TRACK_USERNAME kullanılır)
TRACK_USER_ID=

# 1) Telegram Sesli Telefon Araması (CallMeBot Telegram Phone Call):
# Telegram kullanıcı adınız (@username). CallMeBot sizi Telegram üzerinden sesli arar.
CALLMEBOT_TELEGRAM_USER=@your_telegram_username

# 2) WhatsApp Bildirimi / Araması (İsteğe bağlı):
# Telefon numaranız (+905xxxxxxxxx) ve CallMeBot WhatsApp API Key
CALLMEBOT_WHATSAPP_PHONE=
CALLMEBOT_WHATSAPP_APIKEY=

# Aramalar arası bekleme süresi (dakika) - sürekli ardışık arama yapıp rahatsız etmemesi için
TRACK_COOLDOWN_MINUTES=10

