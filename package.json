{
  "name": "admeliora-music-bot",
  "version": "1.0.0",
  "description": "AdMeliora Music Discord Bot Panel",
  "main": "main.js",
  "author": "Metehan",
  "scripts": {
    "start": "node supervisor.js",
    "bot": "node index.js"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.0",
    "discord.js": "^14.19.3",
    "dotenv": "^16.5.0",
    "ffmpeg-static": "^5.3.0",
    "isomorphic-unfetch": "^4.0.2",
    "libsodium-wrappers": "^0.8.4",
    "node-windows": "^1.0.0-beta.8",
    "opusscript": "^0.1.1",
    "play-dl": "^1.9.7",
    "spotify-url-info": "^3.3.0",
    "youtube-dl-exec": "^3.1.7",
    "yt-search": "^2.13.1"
  },
  "build": {
    "appId": "com.admeliora.musicbot",
    "productName": "AdMeliora Music Bot",
    "directories": {
      "output": "dist"
    },
    "asar": false,
    "files": [
      "index.js",
      "main.js",
      "panel.html",
      ".env",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "icon.ico",
      "signAndEditExecutable": false
    }
  }
}
